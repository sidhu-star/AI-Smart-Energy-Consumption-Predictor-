def example_6_batch_prediction():
    """Example 6: Batch predictions for multiple days"""
    print("\n" + "=" * 60)
    print("EXAMPLE 6: Batch Prediction")
    print("=" * 60)
    
    # Create data
    print("\n1. Creating sample data...")
    data = create_sample_data(n_samples=8760)
    
    # Train model
    print("\n2. Training model...")
    predictor = EnergyPredictor(model_type='ensemble')
    predictor.train(data=data, test_size=0.2, epochs=20, verbose=0)
    
    # Make batch predictions
    print("\n3. Making batch predictions...")
    predictions_24h = predictor.predict(hours_ahead=24)
    predictions_48h = predictor.predict(hours_ahead=48)
    predictions_7d = predictor.predict(hours_ahead=168)  # 7 days
    
    print(f"\n   24-hour forecast:")
    print(f"      Prediction shape: {predictions_24h['predictions'].get('ensemble', 'N/A')}")
    print(f"   48-hour forecast:")
    print(f"      Prediction shape: {predictions_48h['predictions'].get('ensemble', 'N/A')}")
    print(f"   7-day forecast:")
    print(f"      Prediction shape: {predictions_7d['predictions'].get('ensemble', 'N/A')}")
    
    print("\nExample 6 completed successfully!")



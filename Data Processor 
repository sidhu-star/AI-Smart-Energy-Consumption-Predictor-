"""
Data Processing and Feature Engineering Module
Handles data preprocessing, feature creation, and data validation
"""

import pandas as pd
import numpy as np
from datetime import datetime
import warnings
warnings.filterwarnings('ignore')

from config import DATA_CONFIG, FEATURE_ENGINEERING_CONFIG


class DataProcessor:
    """Handle all data preprocessing and feature engineering"""
    
    def __init__(self, config=None):
        """Initialize data processor"""
        self.config = config or DATA_CONFIG
        self.feature_config = FEATURE_ENGINEERING_CONFIG
        self.processed_data = None
    
    def load_data(self, filepath):
        """
        Load data from CSV file
        
        Args:
            filepath (str): Path to CSV file
            
        Returns:
            pd.DataFrame: Loaded data
        """
        print(f"Loading data from {filepath}...")
        data = pd.read_csv(filepath)
        print(f"Data shape: {data.shape}")
        return data
    
    def validate_data(self, data):
        """
        Validate data structure and content
        
        Args:
            data (pd.DataFrame): Input dataframe
            
        Returns:
            dict: Validation results
        """
        print("Validating data structure...")
        
        results = {
            'valid': True,
            'issues': [],
            'warnings': []
        }
        
        # Check required columns
        required = [DATA_CONFIG['target_column'], 'timestamp']
        missing = [col for col in required if col not in data.columns]
        
        if missing:
            results['valid'] = False
            results['issues'].append(f"Missing required columns: {missing}")
        
        # Check for missing values
        missing_pct = (data.isnull().sum() / len(data) * 100)
        high_missing = missing_pct[missing_pct > 10]
        
        if not high_missing.empty:
            results['warnings'].append(
                f"Columns with >10% missing values: {high_missing.to_dict()}"
            )
        
        # Check timestamp format
        try:
            pd.to_datetime(data['timestamp'])
        except:
            results['issues'].append("Timestamp column format invalid")
            results['valid'] = False
        
        # Check for duplicates
        duplicates = data.duplicated(subset=['timestamp']).sum()
        if duplicates > 0:
            results['warnings'].append(f"Found {duplicates} duplicate timestamps")
        
        print(f"Validation {'PASSED' if results['valid'] else 'FAILED'}")
        
        return results
    
    def handle_missing_values(self, data, method='interpolate'):
        """
        Handle missing values
        
        Args:
            data (pd.DataFrame): Input data
            method (str): 'drop', 'mean', 'interpolate', 'forward_fill'
            
        Returns:
            pd.DataFrame: Data with missing values handled
        """
        print(f"Handling missing values using '{method}'...")
        
        data = data.copy()
        
        if method == 'drop':
            data = data.dropna()
        
        elif method == 'mean':
            for col in data.columns:
                if data[col].dtype in ['float64', 'int64']:
                    data[col].fillna(data[col].mean(), inplace=True)
        
        elif method == 'interpolate':
            for col in data.columns:
                if data[col].dtype in ['float64', 'int64']:
                    data[col] = data[col].interpolate(method='linear')
                    data[col].fillna(method='bfill', inplace=True)
        
        elif method == 'forward_fill':
            data = data.fillna(method='ffill').fillna(method='bfill')
        
        print(f"Missing values after handling: {data.isnull().sum().sum()}")
        
        return data
    
    def remove_outliers(self, data, target_column='consumption_kwh', threshold=3):
        """
        Remove statistical outliers
        
        Args:
            data (pd.DataFrame): Input data
            target_column (str): Column to check for outliers
            threshold (float): Number of standard deviations
            
        Returns:
            pd.DataFrame: Data with outliers removed
        """
        print(f"Removing outliers (threshold: {threshold} std)...")
        
        data = data.copy()
        target = data[target_column]
        
        mean = target.mean()
        std = target.std()
        
        mask = (np.abs(target - mean) <= threshold * std)
        removed = (~mask).sum()
        
        data = data[mask]
        
        print(f"Removed {removed} outliers ({removed/len(mask)*100:.2f}%)")
        
        return data
    
    def engineer_features(self, data, timestamp_column='timestamp'):
        """
        Create new features from existing data
        
        Args:
            data (pd.DataFrame): Input data
            timestamp_column (str): Name of timestamp column
            
        Returns:
            pd.DataFrame: Data with engineered features
        """
        print("Creating engineered features...")
        
        data = data.copy()
        
        # Parse timestamp
        data['timestamp'] = pd.to_datetime(data[timestamp_column])
        
        # Temporal features
        data['hour'] = data['timestamp'].dt.hour
        data['day_of_week'] = data['timestamp'].dt.dayofweek
        data['month'] = data['timestamp'].dt.month
        data['day_of_month'] = data['timestamp'].dt.day
        data['week_of_year'] = data['timestamp'].dt.isocalendar().week
        data['is_weekend'] = data['day_of_week'].isin([5, 6]).astype(int)
        
        # Cyclical encoding for hour
        if self.feature_config['cyclical_encoding']:
            data['hour_sin'] = np.sin(2 * np.pi * data['hour'] / 24)
            data['hour_cos'] = np.cos(2 * np.pi * data['hour'] / 24)
            data['month_sin'] = np.sin(2 * np.pi * data['month'] / 12)
            data['month_cos'] = np.cos(2 * np.pi * data['month'] / 12)
        
        # Lag features
        if self.feature_config['create_lag_features']:
            target_col = DATA_CONFIG['target_column']
            for lag in self.feature_config['lag_periods']:
                data[f'lag_{lag}h'] = data[target_col].shift(lag)
        
        # Rolling features
        if self.feature_config['create_rolling_features']:
            target_col = DATA_CONFIG['target_column']
            for window in self.feature_config['rolling_windows']:
                data[f'rolling_mean_{window}h'] = data[target_col].rolling(
                    window=window
                ).mean()
                data[f'rolling_std_{window}h'] = data[target_col].rolling(
                    window=window
                ).std()
        
        # Trend features
        if self.feature_config['create_trend_features']:
            target_col = DATA_CONFIG['target_column']
            data['trend'] = np.arange(len(data))
            # Detrend
            from scipy import signal
            detrended = signal.detrend(data[target_col].fillna(
                data[target_col].mean()
            ))
            data['detrended'] = detrended
        
        print(f"Created {len(data.columns) - len(data)} new features")
        
        return data
    
    def is_holiday(self, date, holidays=None):
        """
        Check if date is a holiday
        
        Args:
            date (pd.Timestamp): Date to check
            holidays (list): List of holiday dates
            
        Returns:
            int: 1 if holiday, 0 otherwise
        """
        if holidays is None:
            # Default US holidays
            holidays = [
                (1, 1),    # New Year
                (7, 4),    # Independence Day
                (12, 25),  # Christmas
                (11, 24),  # Thanksgiving (varies, simplified)
            ]
        
        return int((date.month, date.day) in holidays)
    
    def add_holiday_features(self, data, timestamp_column='timestamp', holidays=None):
        """Add holiday indicators"""
        data = data.copy()
        data['timestamp'] = pd.to_datetime(data[timestamp_column])
        data['is_holiday'] = data['timestamp'].apply(
            lambda x: self.is_holiday(x, holidays)
        )
        return data
    
    def preprocess(self, filepath, remove_outliers=True, engineer_features=True):
        """
        Complete preprocessing pipeline
        
        Args:
            filepath (str): Path to data file
            remove_outliers (bool): Whether to remove outliers
            engineer_features (bool): Whether to create new features
            
        Returns:
            pd.DataFrame: Processed data
        """
        # Load
        data = self.load_data(filepath)
        
        # Validate
        validation = self.validate_data(data)
        if not validation['valid']:
            print("Validation failed!")
            return None
        
        # Handle missing
        data = self.handle_missing_values(
            data,
            method=self.config['handle_missing_values']
        )
        
        # Remove outliers
        if remove_outliers and self.config['remove_outliers']:
            data = self.remove_outliers(
                data,
                target_column=self.config['target_column'],
                threshold=self.config['outlier_threshold']
            )
        
        # Add holidays
        data = self.add_holiday_features(data)
        
        # Engineer features
        if engineer_features:
            data = self.engineer_features(data)
        
        # Drop NaN created by lag/rolling features
        data = data.dropna()
        
        print(f"Final data shape: {data.shape}")
        
        self.processed_data = data
        
        return data
    
    def save_processed_data(self, filepath):
        """Save processed data to CSV"""
        if self.processed_data is None:
            print("No processed data to save")
            return
        
        self.processed_data.to_csv(filepath, index=False)
        print(f"Saved processed data to {filepath}")
    
    def get_statistics(self, data, target_column='consumption_kwh'):
        """Get data statistics"""
        stats = {
            'count': len(data),
            'mean': data[target_column].mean(),
            'std': data[target_column].std(),
            'min': data[target_column].min(),
            'max': data[target_column].max(),
            'median': data[target_column].median(),
            '25_percentile': data[target_column].quantile(0.25),
            '75_percentile': data[target_column].quantile(0.75),
        }
        return stats


def create_sample_data(n_samples=8760, seed=42):
    """
    Create sample energy consumption data for testing
    
    Args:
        n_samples (int): Number of hourly samples (8760 = 1 year)
        seed (int): Random seed
        
    Returns:
        pd.DataFrame: Sample data
    """
    np.random.seed(seed)
    
    dates = pd.date_range(start='2023-01-01', periods=n_samples, freq='H')
    
    # Base load + daily pattern + random noise
    hour_of_day = dates.hour
    base_load = 1000
    daily_pattern = 200 * np.sin(2 * np.pi * hour_of_day / 24)
    noise = np.random.normal(0, 100, n_samples)
    consumption = base_load + daily_pattern + noise
    
    # Weather data
    temperature = 15 + 10 * np.sin(2 * np.pi * np.arange(n_samples) / (24*365)) + np.random.normal(0, 5, n_samples)
    humidity = 60 + 20 * np.sin(2 * np.pi * np.arange(n_samples) / (24*365)) + np.random.normal(0, 5, n_samples)
    pressure = 1013 + np.random.normal(0, 3, n_samples)
    
    data = pd.DataFrame({
        'timestamp': dates,
        'consumption_kwh': consumption,
        'temperature': temperature,
        'humidity': humidity,
        'pressure': pressure,
    })
    
    return data


if __name__ == '__main__':
    # Example usage
    print("Creating sample data...")
    sample_data = create_sample_data(1000)
    sample_data.to_csv('sample_energy_data.csv', index=False)
    print("Sample data created: sample_energy_data.csv")
